# ==========================================
# PARK AVENUE MENSWEAR — ENVIRONMENT CONFIGURATION
# ==========================================

# Server & Runtime
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/park_avenue_menswear
DATABASE_URL=mongodb://127.0.0.1:27017/park_avenue_menswear

# Authentication & Security
JWT_SECRET=your-256-bit-secret-jwt-key-change-in-production

# Customer Notification Gateway (Email)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your_api_key_here
EMAIL_FROM="Park Avenue Menswear <concierge@parkavenuemenswear.com>"

# Customer Notification Gateway (SMS)
SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_auth_token_here
SMS_ACCOUNT_SID=your_twilio_account_sid_here
SMS_FROM_NUMBER=+18005557275

# Customer Notification Gateway (WhatsApp)
WHATSAPP_PROVIDER=meta-cloud
WHATSAPP_API_KEY=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Payment Gateway (Stripe / Square / Authorize.Net)
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET=sk_live_your_payment_provider_secret_here
PAYMENT_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# JWT signing secret (server-only; use a long random value in Vercel)
# AUTH_SECRET=optional-alias-for-JWT_SECRET
