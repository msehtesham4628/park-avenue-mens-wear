{
  "version": 2,
  "builds": [
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/data/**",
          "public/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/returns-policy|/return-policy",
      "status": 301,
      "headers": { "Location": "/returns" }
    },
    {
      "src": "/terms-and-conditions|/terms-of-service",
      "status": 301,
      "headers": { "Location": "/terms" }
    },
    {
      "src": "/category/products/(.*)",
      "status": 301,
      "headers": { "Location": "/product/$1" }
    },
    {
      "src": "/(sitemap\\.xml|sitemap_index\\.xml|sitemap_pages\\.xml|sitemap_products_[0-9]+\\.xml|robots\\.txt)",
      "dest": "/api/[...path].ts"
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0",
        "Pragma": "no-cache",
        "Expires": "0"
      },
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
